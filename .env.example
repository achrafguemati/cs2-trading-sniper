# ==============================================================================
# CS2 Trading Sniper — Environment Configuration Template
# ==============================================================================
# Notification channels below (Discord & Telegram) are 100% FREE to set up and use.
# No paid subscriptions, paid APIs, VPS servers, or recurring fees required.
# See docs/notifications-setup.md for step-by-step setup instructions.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local Database & Steam Account Configuration
# ------------------------------------------------------------------------------
# Local SQLite database path (defaults to data/sniper.db)
SNIPER_DB_PATH=data/sniper.db

# Your 17-digit public SteamID64 (starts with 7656119...)
# Optional: used as the default account for inventory monitoring
STEAMID64=76561198000000000

# ------------------------------------------------------------------------------
# 2. Discord Incoming Webhooks (100% Free)
# ------------------------------------------------------------------------------
# Create a free server -> Channel settings -> Integrations -> Webhooks -> New Webhook
# Copy the full Webhook URL here:
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
# Optional: enable or disable Discord channel (defaults to true)
DISCORD_ENABLED=true

# ------------------------------------------------------------------------------
# 3. Telegram Bot API (100% Free)
# ------------------------------------------------------------------------------
# 1. Message @BotFather on Telegram, send /newbot, and copy the Bot Token.
# 2. IMPORTANT: You MUST start the bot (click Start or send /start in Telegram)
#    or add it to your group before it can deliver alerts to you.
# 3. Message @userinfobot to get your personal Chat ID (or get group chat ID).
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_12345678
TELEGRAM_CHAT_ID=123456789
# Optional: enable or disable Telegram channel (defaults to true)
TELEGRAM_ENABLED=true
